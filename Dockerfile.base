# syntax=docker/dockerfile:1
#
# Heavy layer: Arch system packages, toolchains, the pi binary, the dev user.
# This is the part that takes minutes, so it is its own image: build it once,
# rebuild it deliberately (run-container --rebuild-base), and let ./Dockerfile
# (config + editor state, changes all the time) start from it in seconds.
#
#   podman build -f Dockerfile.base -t cachyos-dev-base:local .
#
# Keep BASE_IMAGE pinned (tag or @sha256:...) while you work: a floating
# :latest that silently refreshes invalidates every layer below it.
ARG BASE_IMAGE=docker.io/cachyos/cachyos-v3:latest
FROM ${BASE_IMAGE}

ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000

# ---- System packages -------------------------------------------------------
# pacman's hook/scriptlet sandbox tries to create a network namespace, which is
# not permitted inside an (unprivileged) container build, hence the sed.
# The package cache is a cache mount: it survives across builds (fast -Syu
# rebuilds) without ending up in the image layers. Needs BuildKit (docker>=23)
# or buildah (podman>=3), which is all this project builds with.
# podman/podman-compose (+ crun, slirp4netns, fuse-overlayfs) are for running
# containers *inside* this dev container; see the note in compose.yaml.
RUN --mount=type=cache,target=/var/cache/pacman/pkg,sharing=locked \
  sed -i '/^\[options\]/a DisableSandboxNetwork' /etc/pacman.conf \
  && sed -i 's/^#*ParallelDownloads.*/ParallelDownloads = 20/' /etc/pacman.conf \
  && pacman -Syu --noconfirm --needed \
  base-devel git openssh sudo \
  fish neovim kitty-terminfo \
  ripgrep fd fzf lazygit tree-sitter-cli unzip curl wget \
  python luarocks uv \
  nodejs npm pnpm yarn \
  go gopls delve golangci-lint \
  rustup \
  tmux jq \
  shellcheck \
  yay

# ---- Non-root user (UID/GID match the host so bind mounts stay writable) ---
# -l: don't create a huge sparse lastlog/faillog entry for a high UID
RUN groupadd -g ${USER_GID} ${USERNAME} 2>/dev/null || true \
  && useradd -l -m -u ${USER_UID} -g ${USER_GID} -s /usr/bin/fish ${USERNAME} \
  && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
  && chmod 0440 /etc/sudoers.d/${USERNAME} \
  && mkdir -p /workspace \
  && chown ${USERNAME}:${USER_GID} /workspace

USER ${USERNAME}
ENV HOME=/home/${USERNAME} \
  CARGO_HOME=/home/${USERNAME}/.cargo \
  RUSTUP_HOME=/home/${USERNAME}/.rustup \
  GOPATH=/home/${USERNAME}/go \
  NPM_CONFIG_PREFIX=/home/${USERNAME}/.npm-global \
  SHELL=/usr/bin/fish \
  EDITOR=nvim \
  LANG=C.UTF-8 \
  COLORTERM=truecolor
ENV PATH=${CARGO_HOME}/bin:${GOPATH}/bin:${NPM_CONFIG_PREFIX}/bin:${HOME}/.local/bin:${PATH}
WORKDIR /home/${USERNAME}

# ---- Rust toolchain --------------------------------------------------------
# --profile minimal skips rust-docs (~300 MB unpacked) and the rest of the
# default profile; the components we want are requested explicitly, which also
# collapses two sequential downloads into one.
# Mount $RUSTUP_HOME/downloads only -- mounting the whole RUSTUP_HOME would keep
# the toolchain itself out of the image. uid/gid are required, otherwise a fresh
# cache mount is root-owned and this RUN cannot write to it.

RUN mkdir -p ~/.rustup ~/.cargo \
  && chown -R ${USER_UID}:${USER_GID} ~/.rustup ~/.cargo

RUN --mount=type=cache,target=/home/${USERNAME}/.rustup/downloads,uid=${USER_UID},gid=${USER_GID},sharing=locked \
  rustup toolchain install stable --profile minimal \
  -c rust-analyzer -c clippy -c rustfmt \
  && rustup default stable

