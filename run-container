#!/usr/bin/env bash
# run-container: build the dev image and run/manage multiple dev containers.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
HERE="$(dirname "$SELF")"
IMAGE="${CDEV_IMAGE:-cachyos-dev:latest}"
PREFIX="cdev-"
LABEL="cachyos-dev"
VOL_PREFIX="cachyos-dev" # same names compose used, so existing caches are reused
DEFAULT_PORTS=(2999 3000)
VOLUMES=(
  nvim-data:/home/dev/.local/share/nvim
  nvim-state:/home/dev/.local/state/nvim
  cargo-registry:/home/dev/.cargo/registry
  cargo-git:/home/dev/.cargo/git
  go-pkg:/home/dev/go/pkg
  npm-global:/home/dev/.npm-global
  cache:/home/dev/.cache
)

usage() {
  cat <<'EOF'
Usage: run-container [COMMAND] [ARGS]

  build [--no-cache]            Build the image
  run [DIR] [options] [-- CMD]  Start (or reuse) the container for DIR and open a shell
                                (default command if no subcommand is given, DIR defaults to .)
      -n, --name NAME           Container name (cdev-NAME); use to run several for one dir
      -p, --port [HOST:]PORT    Publish a port on 127.0.0.1 (repeatable; default 2999, 3000;
                                a busy host port is replaced by a random free one)
      --no-ports                Publish nothing
      --build                   Rebuild the image first
      --recreate                Remove and recreate the container (e.g. after a rebuild)
      --rm                      Throwaway container, removed on exit
  shell [NAME] [-- CMD]         Open another shell in a running container
  start [NAME|--all]            Start stopped container(s)
  stop  [NAME|--all]            Stop container(s)
  rm    [NAME|--all]            Remove container(s)
  ls                            List containers and their ports/directories

NAME may be given with or without the "cdev-" prefix. Without NAME, commands
act on the container for the current directory.
EOF
}

die() {
  echo "run-container: $*" >&2
  exit 1
}

exists() { podman container exists "$1"; }
state() { podman inspect -f '{{.State.Status}}' "$1"; }
label() { podman inspect -f "{{index .Config.Labels \"$2\"}}" "$1" 2>/dev/null; }
is_ours() { [[ "$(label "$1" "$LABEL")" == 1 ]]; }
sanitize() { printf '%s' "$1" | tr -c 'a-zA-Z0-9_.-' '-'; }
default_name() { echo "$PREFIX$(sanitize "$(basename "$(cd "$1" && pwd -P)")")"; }

resolve() {
  if exists "$PREFIX$1"; then
    echo "$PREFIX$1"
  elif exists "$1" && is_ours "$1"; then
    echo "$1"
  else die "no such container: $1"; fi
}

target() { # optional NAME, else the container for $PWD
  if [[ -n "${1:-}" ]]; then
    resolve "$1"
    return
  fi
  local n
  n="$(default_name "$PWD")"
  exists "$n" || die "no container for $PWD (give a NAME; see: run-container ls)"
  echo "$n"
}

names_from() {
  case "${1:-}" in
  -a | --all) podman ps -a --filter "label=$LABEL" --format '{{.Names}}' ;;
  "") target "" ;;
  *)
    local n
    for n in "$@"; do resolve "$n"; done
    ;;
  esac
}

build_image() {
  podman build \
    --build-arg USER_UID="$(id -u)" --build-arg USER_GID="$(id -g)" \
    -t "$IMAGE" "$@" "$HERE"
}

port_busy() { ss -ltnH "sport = :$1" 2>/dev/null | grep -q .; }
port_arg() {
  case "$1" in
  *:*:*) echo "$1" ;;
  *:*) echo "127.0.0.1:$1" ;;
  *) if port_busy "$1"; then echo "127.0.0.1::$1"; else echo "127.0.0.1:$1:$1"; fi ;;
  esac
}

cmd_build() { build_image "$@"; }

cmd_run() {
  local dir="." name="" build=0 recreate=0 ephemeral=0 noports=0
  local ports=() cmd=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -n | --name)
      name="${2:?--name needs a value}"
      shift 2
      ;;
    -p | --port)
      ports+=("${2:?--port needs a value}")
      shift 2
      ;;
    --no-ports)
      noports=1
      shift
      ;;
    --build)
      build=1
      shift
      ;;
    --recreate)
      recreate=1
      shift
      ;;
    --rm)
      ephemeral=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      cmd=("$@")
      break
      ;;
    -*) die "unknown option: $1" ;;
    *)
      dir="$1"
      shift
      ;;
    esac
  done

  [[ -d "$dir" ]] || die "not a directory: $dir"
  local project
  project="$(cd "$dir" && pwd -P)"
  if [[ -n "$name" ]]; then name="$PREFIX$(sanitize "$name")"; else name="$(default_name "$project")"; fi

  if ((build)) || ! podman image exists "$IMAGE"; then build_image; fi

  local portargs=() p
  if ((!noports)); then
    ((${#ports[@]})) || ports=("${DEFAULT_PORTS[@]}")
    for p in "${ports[@]}"; do portargs+=(-p "$(port_arg "$p")"); done
  fi

  ((ephemeral)) && name="$name-tmp$$"
  local args=(
    --name "$name" --hostname "$name"
    --label "$LABEL=1" --label "$LABEL.dir=$project"
    --userns=keep-id --init
    --workdir /workspace
    --env "TERM=${TERM:-xterm-kitty}" --env COLORTERM=truecolor
    --sysctl net.ipv6.conf.all.disable_ipv6=1
    --sysctl net.ipv6.conf.default.disable_ipv6=1
    --volume "$project:/workspace:Z"
  )
  local v
  for v in "${VOLUMES[@]}"; do args+=(--volume "${VOL_PREFIX}_${v%%:*}:${v#*:}"); done

  if ((ephemeral)); then
    exec podman run --rm -it "${args[@]}" "${portargs[@]}" "$IMAGE" "${cmd[@]:-fish}"
  fi

  if ((recreate)) && exists "$name"; then podman rm -f "$name" >/dev/null; fi
  if exists "$name"; then
    local other
    other="$(label "$name" "$LABEL.dir")"
    [[ "$other" == "$project" ]] || die "$name already exists for $other; use -n NAME for another one"
    [[ "$(state "$name")" == running ]] || podman start "$name" >/dev/null
  else
    podman run -d "${args[@]}" "${portargs[@]}" "$IMAGE" sleep infinity >/dev/null
    echo "created $name"
  fi
  exec podman exec -it "$name" "${cmd[@]:-fish}"
}

cmd_shell() {
  local name=""
  if [[ $# -gt 0 && "$1" != "--" ]]; then
    name="$1"
    shift
  fi
  [[ "${1:-}" == "--" ]] && shift
  local n
  n="$(target "$name")"
  [[ "$(state "$n")" == running ]] || podman start "$n" >/dev/null
  exec podman exec -it "$n" "${@:-fish}"
}

cmd_each() { # start|stop|rm
  local action="$1"
  shift
  local ns
  mapfile -t ns < <(names_from "$@")
  ((${#ns[@]})) || {
    echo "nothing to do"
    return 0
  }
  case "$action" in
  start) podman start "${ns[@]}" ;;
  stop) podman stop -t 2 "${ns[@]}" ;;
  rm) podman rm -f "${ns[@]}" ;;
  esac
}

cmd_ls() {
  podman ps -a --filter "label=$LABEL" \
    --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}\t{{index .Labels "cachyos-dev.dir"}}'
}

command -v podman >/dev/null || die "podman not found"

case "${1:-}" in
build)
  shift
  cmd_build "$@"
  ;;
run)
  shift
  cmd_run "$@"
  ;;
shell | sh | attach)
  shift
  cmd_shell "$@"
  ;;
start | stop | rm)
  a="$1"
  shift
  cmd_each "$a" "$@"
  ;;
ls | list | ps) cmd_ls ;;
help | -h | --help) usage ;;
*) cmd_run "$@" ;;
esac
