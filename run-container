#!/usr/bin/env bash
# run-container [DIR] [--build] [--rebuild-base] [-- COMMAND...]
# Start the dev container with DIR (default: current directory) mounted at /workspace.
#   --build          rebuild the app image (Dockerfile, seconds)
#   --rebuild-base   also rebuild the heavy base image (Dockerfile.base, minutes)
set -euo pipefail

# Resolve symlinks so this works when linked into ~/.local/bin
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
HERE="$(dirname "$SELF")"
COMPOSE_FILE="$HERE/compose.yaml"
IMAGE="cachyos-dev:latest"
BASE_IMAGE="${BASE_IMAGE:-cachyos-dev-base:local}" # must match ARG BASE_IMAGE in Dockerfile
export BASE_IMAGE
PROJECT_NAME="cachyos-dev" # fixed, so cache volumes are shared by all projects
# Prefer podman-compose (talks to podman directly, no socket needed).
# `podman compose` may delegate to docker-compose, which needs podman.socket.
if [[ -n "${CONTAINER_COMPOSE:-}" ]]; then
  COMPOSE=($CONTAINER_COMPOSE)
elif command -v podman-compose >/dev/null 2>&1; then
  COMPOSE=(podman-compose)
else
  export PODMAN_COMPOSE_WARNING_LOGS=false
  COMPOSE=(podman compose)
fi

# Engine for the bookkeeping compose does not do for us (is an image already
# present? build Dockerfile.base). Overridable with CONTAINER_CLI.
if [[ -n "${CONTAINER_CLI:-}" ]]; then
  read -r -a CLI <<<"$CONTAINER_CLI"
elif command -v podman >/dev/null 2>&1; then
  CLI=(podman)
elif command -v docker >/dev/null 2>&1; then
  CLI=(docker)
else
  CLI=()
fi

# Does the engine already know this image?
img_exists() {
  ((${#CLI[@]})) || return 1
  if [[ "${CLI[0]}" == podman ]]; then
    podman image exists "$1" 2>/dev/null
  else
    "${CLI[@]}" image inspect "$1" >/dev/null 2>&1
  fi
}

dir="."
build=0
rebuild_base=0
cmd=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --build)
    build=1
    shift
    ;;
  --rebuild-base)
    build=1
    rebuild_base=1
    shift
    ;;
  -h | --help)
    sed -n '2,5p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  --)
    shift
    cmd=("$@")
    break
    ;;
  *)
    dir="$1"
    shift
    ;;
  esac
done

if [[ ! -d "$dir" ]]; then
  echo "run-container: not a directory: $dir" >&2
  exit 1
fi
PROJECT_DIR="$(cd "$dir" && pwd -P)"
export PROJECT_DIR
export USER_UID="$(id -u)" USER_GID="$(id -g)"

# ---- Git identity from this machine -----------------------------------------
# Two files end up in the container (see compose.yaml):
#   ~/.gitconfig.host  = your own git config, read-only, so aliases, pager,
#                        credential helpers ... carry over unchanged.
#   ~/.gitconfig       = generated here: includes the file above and then pins
#                        user.name/user.email as they resolve for $PROJECT_DIR on
#                        this machine. That also covers includeIf "gitdir:..."
#                        rules, which can never match a /workspace path. Being
#                        global-scope it still loses to repo-local config, so
#                        `git config user.email ...` inside a repo keeps working.
escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }

GIT_CONFIG_HOST="${GIT_CONFIG_HOST:-}"
if [[ -z "$GIT_CONFIG_HOST" ]]; then
  for f in "${GIT_CONFIG_GLOBAL:-}" "$HOME/.config/git/config" "$HOME/.gitconfig"; do
    if [[ -n "$f" && -f "$f" ]]; then GIT_CONFIG_HOST="$f"; break; fi
  done
fi
export GIT_CONFIG_HOST

git_name="$(git -C "$PROJECT_DIR" config --get user.name 2>/dev/null || true)"
git_email="$(git -C "$PROJECT_DIR" config --get user.email 2>/dev/null || true)"
identity_file="${XDG_CACHE_HOME:-$HOME/.cache}/cachyos-dev/gitconfig"
if [[ -n "$GIT_CONFIG_HOST" || -n "$git_email" ]]; then
  mkdir -p "$(dirname "$identity_file")"
  {
    if [[ -n "$GIT_CONFIG_HOST" ]]; then
      # path must match the mount target in compose.yaml
      printf '[include]\n\tpath = /home/dev/.gitconfig.host\n'
    fi
    if [[ -n "$git_name" && -n "$git_email" ]]; then
      printf '[user]\n\tname = %s\n\temail = %s\n' "$(escape "$git_name")" "$(escape "$git_email")"
    fi
  } >"$identity_file"
  export GIT_IDENTITY_FILE="$identity_file"
fi
if [[ -z "$git_name" || -z "$git_email" ]]; then
  echo "run-container: no git user.name/user.email found; commits will use ${USER:-$(id -un)}@${HOSTNAME:-localhost}" >&2
fi

base=("${COMPOSE[@]}" -f "$COMPOSE_FILE" -p "$PROJECT_NAME")

# Base image: system packages + toolchains (Dockerfile.base). Built once, then
# reused; --rebuild-base forces a fresh one.
if ((rebuild_base)) || ! img_exists "$BASE_IMAGE"; then
  ((${#CLI[@]})) || {
    echo "run-container: neither podman nor docker found on PATH" >&2
    exit 1
  }
  echo "run-container: building base image ${BASE_IMAGE} (slow, only once)" >&2
  "${CLI[@]}" build -f "$HERE/Dockerfile.base" -t "$BASE_IMAGE" "$HERE"
fi

# App image: rebuilt only when missing or when --build was given. The old check
# ran `podman image exists` unconditionally, which always fails on a Docker-only
# host -- so it built on every single invocation.
if ((build)) || ! img_exists "$IMAGE"; then
  "${base[@]}" build
fi

exec "${base[@]}" run --rm --service-ports dev "${cmd[@]}"
